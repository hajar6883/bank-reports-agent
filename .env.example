# Postgres + pgvector (docker compose up -d)
DATABASE_URL=postgresql://bra:bra@localhost:5433/bra

# LLMs, as "provider:model" (any provider supported by langchain's init_chat_model).
# Examples: openai:gpt-4.1-mini, anthropic:claude-haiku-4-5, mistralai:mistral-small-latest
LLM_MODEL=openai:gpt-4.1-mini
JUDGE_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# Embeddings: "local:<sentence-transformers model>" (free, CPU) or "openai:<model>"
EMBED_MODEL=local:intfloat/multilingual-e5-base

# Full-text search dictionary: english for English reports, french for French ones
FTS_CONFIG=english

# Optional: price per 1M tokens for the cost column in the eval report.
# Copy them from your provider's pricing page; leave 0 to report tokens only.
PRICE_INPUT_PER_M=0
PRICE_OUTPUT_PER_M=0

# Optional: Arize Phoenix tracing (pip install -e ".[tracing]", then `phoenix serve`)
TRACING=off
